{
  "name": "live-studio",
  "version": "1.0.0",
  "description": "KLH Lecture Studio - lecture recording and YouTube streaming for KLH University, Aziznagar Campus",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/main/index.cjs --external:electron --external:ffmpeg-static --external:obs-websocket-js --sourcemap",
    "dev:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/preload/index.cjs --external:electron --sourcemap",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/main/index.cjs --external:electron --external:ffmpeg-static --external:obs-websocket-js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/preload/index.cjs --external:electron",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "test": "esbuild tests/runTests.ts --bundle --platform=node --outfile=dist/tests/runTests.cjs --external:electron --external:ffmpeg-static && node dist/tests/runTests.cjs",
    "start": "npm run build && electron dist/main/index.cjs",
    "dev": "npm run build:main && npm run build:preload && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron dist/main/index.cjs\"",
    "app": "powershell -Command \"Start-Process 'release/win-unpacked/KLH Lecture Studio.exe'\"",
    "dist": "npm run build && electron-builder --win"
  },
  "keywords": [
    "live-streaming",
    "screen-recording",
    "annotation",
    "obs",
    "youtube-live",
    "electron"
  ],
  "author": "KLH University - Aziznagar Campus",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.62.0",
    "obs-websocket-js": "^5.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "in.edu.klh.lecturestudio",
    "productName": "KLH Lecture Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
